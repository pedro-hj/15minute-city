# Example of environment configuration file.
# Copy this file to .env and replace with your database credentials.

# Option 1: Cloud Database (Aiven PostgreSQL + PostGIS)
DATABASE_URL=postgresql+psycopg://avnadmin:your_password@your-aiven-host.aivencloud.com:28414/defaultdb?sslmode=require

# Option 2: Local Docker Container (docker compose --profile local-db up -d)
# DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@localhost:5432/defaultdb?sslmode=disable

# API authentication. Use a long random value and send it in the X-API-Key header.
# Multiple keys can be separated by commas during the initial API phase.
API_KEYS=replace-with-a-long-random-key

# Optional dedicated read-only connection used by the API container.
# API_DATABASE_URL=postgresql+psycopg://api_reader:password@host/database?sslmode=require

# Optional comma-separated list of browser origins allowed to call the API.
# CORS_ORIGINS=https://example.com,https://app.example.com
